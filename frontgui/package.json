{
  "name": "frontgui",
  "private": true,
  "version": "0.0.0",
  "description": "electron的前端vue层",
  "author": "阿鑫",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.vue,.mjs --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx,.vue,.mjs",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,scss,json}\"",
    "fix": "npm run lint && npm run format && npm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "axios": "^1.13.4",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.1",
    "gsap": "^3.14.2",
    "localforage": "^1.10.0",
    "lottie-web": "^5.13.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.4",
    "@types/node": "^25.2.2",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "prettier": "^3.4.1",
    "sass-embedded": "^1.97.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^6.0.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
